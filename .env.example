# Copiá este archivo como .env y completá UNA clave de LLM. El .env NUNCA se sube al repo.

# --- Redis (estado de jobs + checkpoints de LangGraph). Requiere Redis Stack ---
REDIS_URL=redis://localhost:6379

# --- LLM: openai | google | anthropic  (o "mock" para correr sin API keys) ---
LLM_PROVIDER=google
# LLM_MODEL=
# LLM_REQUESTS_PER_MINUTE=4      # solo si usás el plan gratuito de Gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Arize Phoenix ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=agente-multiagente-prod
# PHOENIX_DISABLED=1             # apaga la instrumentación

# --- Workers ---
WORKER_CONCURRENCY=5
JOB_TIMEOUT_S=600
